<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Загрузки и фоновое воспроизведение живут в foreground-сервисах. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Возобновление прерванных загрузок после перезагрузки телефона. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Установка скачанного APK при обновлении из GitHub. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".app.AnilibrixApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AnilibrixPlus"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          windowSoftInputMode=adjustResize — вторая половина того, что заставляет
          Modifier.imePadding() работать; без него клавиатура перекрывает поля
          ввода в поиске и авторизации.
          uiMode в configChanges — чтобы системное переключение светлой/тёмной
          не пересоздавало Activity (актуально с режимом «Системная»).
          smallestScreenSize|screenLayout — обязательны для «картинки в картинке»:
          без них система пересоздаёт Activity при входе в PiP, и
          воспроизведение обрывается ровно в момент сворачивания.
        -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.AnilibrixPlus.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Возврат из браузера после входа в Shikimori. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anilibrixplus" android:host="shikimori" />
            </intent-filter>
        </activity>

        <!-- Скачивание серий: переживает уход приложения в фон. -->
        <service
            android:name=".core.download.AnilibrixDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Фоновое воспроизведение и контролы на экране блокировки. -->
        <service
            android:name=".core.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Установка скачанного обновления: APK отдаётся системе через content://. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Отключаем автоматическую инициализацию WorkManager.

          Приложение реализует Configuration.Provider и отдаёт HiltWorkerFactory,
          но стандартный androidx.startup-инициализатор успевает создать
          WorkManager раньше — с конфигурацией по умолчанию. Из-за этого воркеры
          с @HiltWorker пытались создаваться рефлексией и падали с
          NoSuchMethodException: конструктора (Context, WorkerParameters) у них
          нет. Проверка новых серий, то есть все фоновые уведомления, при этом
          не работала вовсе.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <meta-data
            android:name="com.bumptech.glide.module"
            android:value="com.anilibrix.plus.app.di.GlideModule" />

    </application>

</manifest>

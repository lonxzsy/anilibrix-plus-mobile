<?xml version="1.0" encoding="utf-8"?>
<!--
  Пути, которые FileProvider вправе отдавать наружу.

  Только каталог со скачанными обновлениями: APK нужно передать системному
  установщику через content://, а прямой file:// с API 24 запрещён. Ничего
  другого наружу не открываем — здесь лежат токены и база пользователя.
-->
<paths>
    <cache-path name="app_updates" path="updates/" />
</paths>
